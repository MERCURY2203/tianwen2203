# 小手机的设置文件。改完后关掉窗口、重新双击启动才会生效。

# 管理员邮箱：用这个邮箱登录不需要邀请码，并且能生成邀请码
ADMIN_EMAIL=

# 网址端口（一般不用改）
PORT=8080

# 验证码怎么给：screen = 直接显示在登录页（只能本机/同一 WiFi 使用）；smtp = 发邮件（第 3 阶段接入）
MAIL_MODE=screen

# 注册方式：invite = 需要邀请码；open = 任何人都能注册
REGISTRATION=invite

# 角色回复用哪个模型：deepseek = 正式；mock = 测试回复（不花钱）
MODEL_PROVIDER=deepseek

# DeepSeek 密钥（在 platform.deepseek.com 的 API keys 页面创建）
# 第一个用于角色回复和看图；第二个只用于整理记忆（可不填，不填就共用第一个）
DEEPSEEK_API_KEY=
DEEPSEEK_MEMORY_API_KEY=

# 角色回复用 deepseek-v4-pro；看图和整理记忆用 deepseek-flash
CHAT_MODEL=deepseek-v4-pro
VISION_MODEL=deepseek-flash
MEMORY_MODEL=deepseek-flash

# 深度思考：none = 关闭（更快更省钱）；low / high = 开启
CHAT_REASONING=none

# 每多少条新消息自动整理一次记忆
MEMORY_EVERY=8

# 自动备份保留几天
BACKUP_KEEP_DAYS=7
